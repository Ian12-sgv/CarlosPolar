# Copiar a .env y ajustar.
DATABASE_URL="postgresql://carlos_polar:carlos_polar@localhost:5432/carlos_polar?schema=public"
PORT=3000
# Carpeta donde se guardan firmas, evidencias y PDFs.
STORAGE_DIR="../../storage"

# Sesiones
ACCESO_MINUTOS=30
SESION_DIAS=30

# Inventario (RESERVA_HORAS pendiente de confirmar con el negocio)
RESERVA_HORAS=48
BARRIDO_RESERVAS_MINUTOS=5
ALMACEN_PRINCIPAL="ALM-PRINCIPAL"

# Crédito
FUENTE_TASA="BCV"
TASA_MAX_DIAS=3
DIAS_PROXIMO_VENCER=7

# HTTPS (opcional; obligatorio para la app Android instalada). Ver docs/distribucion.md
# HTTPS_CERT="C:/ruta/apps/api/certificados/servidor.crt"
# HTTPS_KEY="C:/ruta/apps/api/certificados/servidor.key"
